# Commerza Apache rules

Options -Indexes

<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 10 minutes"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/javascript "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType image/gif "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType image/x-icon "access plus 1 month"
ExpiresByType font/woff "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 month"
ExpiresByType application/font-woff "access plus 1 month"
ExpiresByType video/mp4 "access plus 1 month"
ExpiresByType video/webm "access plus 1 month"
</IfModule>

FileETag MTime Size

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/plain text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml font/ttf font/otf
</IfModule>

<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(?:css|js|mjs|png|jpe?g|gif|webp|svg|ico|avif|woff2?|ttf|eot|mp4|webm)$">
Header set Cache-Control "public, max-age=2592000, immutable, stale-while-revalidate=604800, stale-if-error=2592000"
</FilesMatch>
Header append Vary Accept-Encoding
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Cross-Origin-Resource-Policy "same-site"
Header always set X-Permitted-Cross-Domain-Policies "none"
Header always set X-XSS-Protection "0"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# Enforce HTTPS in production while keeping localhost development flows intact.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Deny uncommon HTTP methods that should never be used by the storefront.
RewriteCond %{REQUEST_METHOD} ^(?:TRACE|TRACK|CONNECT|DEBUG|PROPFIND|PROPPATCH|MOVE)$ [NC]
RewriteRule ^ - [F,L]

# Protect environment, dumps, docs, and VCS metadata from direct access.
RewriteRule (^|/)(?:\.env(?:\..*)?|\.ht(?:access|passwd)|web\.config|Thumbs\.db|Desktop\.ini|\.DS_Store|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|README\.md|SECURITY\.md|CHANGELOG\.md|CONTRIBUTING\.md|CODE_OF_CONDUCT\.md|LICENSE|instructions\.md|.*\.(?:sql|bak|log|ini|ps1|sh))$ - [F,L,NC]
RewriteRule (^|/)\.(?:git|svn|hg)(?:/|$) - [F,L,NC]
RewriteRule ^(?:scripts|database|docs|storage|templates|\.github|\.vscode)(?:/|$) - [F,L,NC]
RewriteRule ^backend/core(?:/|$) - [F,L,NC]
RewriteRule ^backend/(?:auth|cache|domain|helpers|jobs|mailer|payment|repositories|security|services)(?:/|$) - [F,L,NC]
RewriteRule ^backend/cache/opcache\.preload\.php$ - [F,L,NC]
RewriteRule ^admin/backend/auth/auth\.php$ - [F,L,NC]

# Block direct browser navigation to backend/admin backend PHP scripts.
# Keep non-navigation API calls (fetch/XHR or JSON clients) operational.
RewriteCond %{REQUEST_URI} (?:^|/)(?:admin/)?backend/.+\.php$ [NC]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{HTTP_SEC_FETCH_DEST} =document [OR]
RewriteCond %{HTTP_SEC_FETCH_MODE} =navigate [OR]
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^ - [F,L]

# Legacy *.php URLs reach the page so PHP can 301 them to the clean route.
RewriteRule ^(index|404|products|account|cart|wishlist|compare|login|signup|forgot-password|reset-password|order-tracking|invoice|oauth|about|contact|faq|shipping|returns|privacy-policy|terms-of-service|warranty|shop-category-a|shop-category-b)\.php$ pages/$1.php [QSA,L,NC]

# Clean storefront routes.
RewriteRule ^$ pages/index.php [QSA,L,NC]
RewriteRule ^home/?$ pages/index.php [QSA,L,NC]
RewriteRule ^index/?$ pages/index.php [QSA,L,NC]
RewriteRule ^error/?$ pages/404.php [QSA,L,NC]

RewriteRule ^product/([a-z0-9-]+)/?$ pages/products.php?slug=$1 [QSA,L,NC]
RewriteRule ^product/?$ pages/products.php [QSA,L,NC]
RewriteRule ^products/([a-z0-9-]+)/?$ pages/products.php?slug=$1 [QSA,L,NC]
RewriteRule ^prodcuts/([a-z0-9-]+)/?$ pages/products.php?slug=$1 [QSA,L,NC]
RewriteRule ^products/?$ pages/products.php [QSA,L,NC]

RewriteRule ^account/([a-z0-9_]+)/?$ pages/account.php?u=$1 [QSA,L,NC]
RewriteRule ^account/?$ pages/account.php [QSA,L,NC]

RewriteRule ^cart/?$ pages/cart.php [QSA,L,NC]
RewriteRule ^wishlist/?$ pages/wishlist.php [QSA,L,NC]
RewriteRule ^compare/?$ pages/compare.php [QSA,L,NC]
RewriteRule ^login/?$ pages/login.php [QSA,L,NC]
RewriteRule ^signup/?$ pages/signup.php [QSA,L,NC]
RewriteRule ^forgot-password/?$ pages/forgot-password.php [QSA,L,NC]
RewriteRule ^reset-password/?$ pages/reset-password.php [QSA,L,NC]
RewriteRule ^order-tracking/?$ pages/order-tracking.php [QSA,L,NC]
RewriteRule ^invoice/(ORD-[A-Z0-9]{4,30})/?$ pages/invoice.php?order=$1 [QSA,L,NC]
RewriteRule ^invoice/?$ pages/invoice.php [QSA,L,NC]
RewriteRule ^oauth/?$ pages/oauth.php [QSA,L,NC]

RewriteRule ^about/?$ pages/about.php [QSA,L,NC]
RewriteRule ^contact/?$ pages/contact.php [QSA,L,NC]
RewriteRule ^faq/?$ pages/faq.php [QSA,L,NC]
RewriteRule ^shipping/?$ pages/shipping.php [QSA,L,NC]
RewriteRule ^returns/?$ pages/returns.php [QSA,L,NC]
RewriteRule ^privacy-policy/?$ pages/privacy-policy.php [QSA,L,NC]
RewriteRule ^terms-of-service/?$ pages/terms-of-service.php [QSA,L,NC]
RewriteRule ^warranty/?$ pages/warranty.php [QSA,L,NC]
RewriteRule ^shop-category-a/?$ pages/shop-category-a.php [QSA,L,NC]
RewriteRule ^shop-category-b/?$ pages/shop-category-b.php [QSA,L,NC]

# Clean admin frontend routes.
RewriteRule ^admin/?$ admin/frontend/admin-login.php [QSA,L,NC]
RewriteRule ^admin-login/?$ admin/frontend/admin-login.php [QSA,L,NC]
RewriteRule ^admin-panel/?$ admin/frontend/admin-panel.php [QSA,L,NC]
RewriteRule ^admin-forgot-password/?$ admin/frontend/admin-forgot-password.php [QSA,L,NC]
RewriteRule ^admin-forgot-email/?$ admin/frontend/admin-forgot-email.php [QSA,L,NC]
RewriteRule ^admin-verify-email/?$ admin/frontend/admin-verify-email.php [QSA,L,NC]
RewriteRule ^admin-verify-2fa/?$ admin/frontend/admin-verify-2fa.php [QSA,L,NC]
RewriteRule ^admin-login\.php$ admin/frontend/admin-login.php [QSA,L,NC]
RewriteRule ^admin-panel\.php$ admin/frontend/admin-panel.php [QSA,L,NC]
RewriteRule ^admin-forgot-password\.php$ admin/frontend/admin-forgot-password.php [QSA,L,NC]
RewriteRule ^admin-forgot-email\.php$ admin/frontend/admin-forgot-email.php [QSA,L,NC]
RewriteRule ^admin-verify-email\.php$ admin/frontend/admin-verify-email.php [QSA,L,NC]
RewriteRule ^admin-verify-2fa\.php$ admin/frontend/admin-verify-2fa.php [QSA,L,NC]

# Keep real files and folders untouched (including backend/admin APIs).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route unknown browser document requests to the custom 404 page.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{HTTP_SEC_FETCH_DEST} =document [OR]
RewriteCond %{HTTP_SEC_FETCH_MODE} =navigate [OR]
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^ pages/404.php [QSA,L]
</IfModule>
